{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "azureTenantId": { "value": "${AZURE_TENANT_ID}" },
    "azureClientId": { "value": "${AZURE_CLIENT_ID}" },
    "azureClientSecret": { "value": "${AZURE_CLIENT_SECRET}" },
    "azureSubscriptionId": { "value": "${AZURE_SUBSCRIPTION_ID}" },
    "dataverseOrgUrls": { "value": "${DATAVERSE_ORG_URLS}" },
    "ppacBillingPolicyId": { "value": "${PPAC_BILLING_POLICY_ID}" },
    "copilotRateStandard": { "value": "${COPILOT_RATE_STANDARD}" },
    "copilotRatePremium": { "value": "${COPILOT_RATE_PREMIUM}" },
    "copilotRateCurrency": { "value": "${COPILOT_RATE_CURRENCY}" },
    "mcpTenantId": { "value": "${MCP_TENANT_ID}" },
    "mcpAudience": { "value": "${MCP_AUDIENCE}" }
  }
}
