# dependencies
/node_modules

# build output
/dist
*.tsbuildinfo

# local env files (keep .env.example)
# NOTE: `.env.*.local` does NOT match `.env.local` - it must be listed explicitly,
# or a file holding real reader credentials ships to whoever clones this repo.
.env
.env.local
.env.*.local

# Internal working backlog. This repo is handed to clients and admins for install;
# the backlog is our own planning surface and is deliberately not part of it.
docs/BACKLOG.md

# Residue from the superseded Next.js stack. Safe to delete from your working copy.
/.next
next-env.d.ts
deploy.zip
BUILD_SUMMARY.txt

# azd
.azure/

# scripts/install.ps1 resume state - app IDs and URLs, never secrets, but
# tenant-specific and not something to commit
.agentlens-install.json

# editors
.vscode/
.idea/
.DS_Store

# logs
npm-debug.log*
*.log

# packaged declarative agent (built by scripts/package-agent.mjs)
/agent/build
