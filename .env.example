# AgentLens MCP server - environment.
#
# Copy to .env and fill in. NEVER commit .env.
# In Azure these are Container App settings; the client secret is a secret ref.
#
# Every value here is optional in the sense that the server always starts. What
# is missing simply shows up as "not connected" in the tool output, with the fix.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# http  = required by Microsoft 365 Copilot (default)
# stdio = local testing only, e.g. MCP Inspector
MCP_TRANSPORT=http
PORT=3000

# ---------------------------------------------------------------------------
# INBOUND auth - who may call this server
# ---------------------------------------------------------------------------
# Leave BOTH blank for local development: the server runs UNAUTHENTICATED and
# the agent package ships auth { "type": "None" } to match.
# Set BOTH before exposing the server publicly.
MCP_TENANT_ID=
# Token audience: the Application ID URI from the Entra SSO auth config, or
# api://<agentlens-mcp-app-id>.
MCP_AUDIENCE=
# Microsoft Enterprise token store. Only change if Microsoft changes it.
MCP_ALLOWED_CLIENT_ID=ab3be6b7-f5df-413d-ac2d-abf1e3fd9c0b

# ---------------------------------------------------------------------------
# OUTBOUND identity - AgentLens-Reader, what this server may read
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Scope for Azure Resource Graph and Azure Cost Management.
# The service principal needs Reader + Cost Management Reader here.
AZURE_SUBSCRIPTION_ID=
# Optional: read cost at a billing account or management group instead.
# AZURE_COST_SCOPE=providers/Microsoft.Billing/billingAccounts/xxxx

# ---------------------------------------------------------------------------
# Dataverse - aggregate usage only
# ---------------------------------------------------------------------------
# Comma separated org URLs, e.g.
#   https://contoso.crm4.dynamics.com,https://contoso-uat.crm4.dynamics.com
# The service principal must be an Application User with a read role in EACH
# environment. Only the aggregated KPI table is read - never message content.
DATAVERSE_ORG_URLS=

# ---------------------------------------------------------------------------
# Per-agent consumption and cost
# ---------------------------------------------------------------------------
# The pay-as-you-go billing policy that meters your agents. Find it in the
# Power Platform admin center under Billing policies. This is what unlocks
# per-agent message counts and per-agent cost - the same data the admin center
# shows. Leave blank if this tenant uses prepaid capacity packs: those are not
# under a billing policy and no API exposes their per-agent consumption.
PPAC_BILLING_POLICY_ID=

# Your message rates, from your price sheet or agreement.
# Leave blank and the published pay-as-you-go list price is used instead,
# labelled as such in every result. Setting them makes each figure yours.
# COPILOT_RATE_STANDARD=0.01
# COPILOT_RATE_PREMIUM=0.025
# COPILOT_RATE_CURRENCY=USD

# ---------------------------------------------------------------------------
# Optional sources
# ---------------------------------------------------------------------------
# Azure AI Foundry project, to include Foundry agents in the sweep.
# FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project

# Read AZURE_CLIENT_SECRET from Key Vault instead of the environment.
# KEY_VAULT_URI=https://your-vault.vault.azure.net/
