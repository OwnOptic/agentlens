# =============================================================================
# AgentLens - Environment Variables Reference
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored - NEVER commit real secrets.
# In production, prefer KEY_VAULT_URI and leave secrets out of env vars.
# =============================================================================


# -----------------------------------------------------------------------------
# Core Service Principal (Power Platform / Graph data reads)
# Used by the ingestion layer and token service for client-credentials flow.
# -----------------------------------------------------------------------------
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-sp-client-id
AZURE_CLIENT_SECRET=your-sp-client-secret


# -----------------------------------------------------------------------------
# Webapp SSO (next-auth Azure AD provider)
# Separate app registration from the core SP - users sign in via this one.
# AZURE_AD_CLIENT_ID required to enable authentication; omit to run auth-optional.
# -----------------------------------------------------------------------------
AZURE_AD_CLIENT_ID=your-webapp-app-registration-client-id
# Canonical name (matches the Key Vault secret WEBAPP-CLIENT-SECRET).
WEBAPP_CLIENT_SECRET=your-webapp-app-registration-client-secret
# Legacy alias - still accepted as a fallback, but prefer WEBAPP_CLIENT_SECRET above.
# AZURE_AD_CLIENT_SECRET=

# Random string used to sign next-auth JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=your-random-32-char-secret

# Full public URL of the app, e.g. https://agentlens.azurewebsites.net
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Azure Key Vault (production only)
# When set, lib/config/secrets.ts reads ALL secrets from Key Vault instead of
# env vars. Use Managed Identity in prod (no extra credential needed).
# Secret names match the SecretName type: AZURE-CLIENT-SECRET, AUTH-SECRET, etc.
# -----------------------------------------------------------------------------
# KEY_VAULT_URI=https://your-keyvault-name.vault.azure.net/


# -----------------------------------------------------------------------------
# Azure OpenAI
# Used by the Ask (AI) page and the analysis layer.
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview


# -----------------------------------------------------------------------------
# Data sources
# SUPABASE_URL + SUPABASE_SERVICE_KEY: analytics store (agent events, KPIs).
# DATABASE_URL: optional direct Azure PostgreSQL connection string.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# DATABASE_URL=postgresql://user:pass@your-pg.postgres.database.azure.com:5432/agentlens?sslmode=require


# -----------------------------------------------------------------------------
# Source connectors
# AGENTLENS_ORG_URLS: comma-separated Dataverse org URLs to scan.
# -----------------------------------------------------------------------------
AGENTLENS_ORG_URLS=https://yourorg.crm.dynamics.com,https://anotherorg.crm.dynamics.com

# DEPRECATED - use MVP_GRAPH_TOKEN for Graph-based reads instead.
# MVP_ARM_TOKEN=eyJ...

# Graph token for MVP tenant live data (dev only - rotate regularly).
MVP_GRAPH_TOKEN=eyJ...

# Azure AI Foundry / Foundry project endpoint for agent metadata reads.
MVP_FOUNDRY_TOKEN=eyJ...
MVP_FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project.cognitiveservices.azure.com

# Microsoft Fabric token for usage/telemetry reads.
MVP_FABRIC_TOKEN=eyJ...


# -----------------------------------------------------------------------------
# Ops
# CRON_SECRET: bearer token that the scheduler sends to /api/cron/* routes.
# TEAMS_WEBHOOK_URL: incoming webhook for alert notifications (optional).
# -----------------------------------------------------------------------------
CRON_SECRET=your-random-cron-secret
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/...
