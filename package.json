{
  "name": "agentlens",
  "version": "0.2.0",
  "private": true,
  "description": "AgentLens - a Microsoft 365 Copilot agent that audits the AI agents in your tenant, and the read-only MCP server behind it",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "package:agent": "node scripts/package-agent.mjs",
    "validate:agent": "node scripts/validate-agent-package.mjs",
    "verify:consumption": "node scripts/verify-consumption-shape.mjs",
    "package:cowork": "node scripts/package-cowork.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/msal-node": "^2.16.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "archiver": "^7.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
