# AgentLens MCP server - environment
#
# Copy to .env and fill in. NEVER commit .env.
# In production these come from Azure Key Vault via app settings references.

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# http  = required by Microsoft 365 Copilot (default)
# stdio = local testing only, e.g. MCP Inspector
MCP_TRANSPORT=http
PORT=3000

# ---------------------------------------------------------------------------
# INBOUND auth - AgentLens-MCP (who is allowed to call this server)
# ---------------------------------------------------------------------------
# Leave BOTH blank for local development: the server runs unauthenticated and
# the agent package ships auth { "type": "None" } to match.
# Set BOTH before exposing the server publicly.
MCP_TENANT_ID=
# The token audience. Use the Application ID URI from the Entra SSO auth config,
# or api://<agentlens-mcp-app-id>.
MCP_AUDIENCE=
# Microsoft Enterprise token store - the client Copilot uses to acquire the token.
# Only change this if Microsoft changes the documented client ID.
MCP_ALLOWED_CLIENT_ID=ab3be6b7-f5df-413d-ac2d-abf1e3fd9c0b

# ---------------------------------------------------------------------------
# OUTBOUND identity - AgentLens-Reader (what this server may read)
# ---------------------------------------------------------------------------
# Same service principal the Next.js console uses. Read-only everywhere.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Needed for Azure Resource Graph scope and Azure Cost Management.
# The SP needs Reader + Cost Management Reader on this scope.
AZURE_SUBSCRIPTION_ID=

# ---------------------------------------------------------------------------
# Dataverse - usage signals, AGGREGATE ONLY
# ---------------------------------------------------------------------------
# Comma separated org URLs, e.g.
#   https://contoso.crm4.dynamics.com,https://contoso-uat.crm4.dynamics.com
# The SP must be an Application User in EACH environment with Read on
# conversationtranscript. No message content is ever read or stored.
DATAVERSE_ORG_URLS=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# If you use Key Vault instead of raw secrets above.
KEY_VAULT_URI=
